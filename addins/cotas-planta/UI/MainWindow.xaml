<Window x:Class="CQEING.CotasPlanta.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CQEING.CotasPlanta.UI"
        xmlns:domain="clr-namespace:CQEING.CotasPlanta.Domain"
        Title="Cotas de planta" Width="1400" Height="900" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Background="#EDEFF2" Foreground="#1B1F24" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0B64B4"/>
        <SolidColorBrush x:Key="AccentHover" Color="#084C8A"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#E6F0FA"/>
        <SolidColorBrush x:Key="Muted" Color="#59626E"/>
        <SolidColorBrush x:Key="Line" Color="#D0D5DB"/>
        <SolidColorBrush x:Key="LineSoft" Color="#E1E5EA"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="Caps" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="Background" Value="#F0F2F5"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style x:Key="Section" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,9"/>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B8C0C9"/>
            <Setter Property="Foreground" Value="#1B1F24"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F5F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#A9B4C0"/>
                    <Setter Property="BorderBrush" Value="#A9B4C0"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1B1F24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" MinHeight="34">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlanItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,2" Padding="8,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F5F7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9DC3E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Encabezado -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn}" Content="Cerrar" Command="{Binding CloseCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryBtn}" Content="{Binding GenerateLabel}" Command="{Binding GenerateCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="6" Background="{StaticResource AccentSoft}" Margin="0,0,12,0">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3,12 H21 M3,8 V16 M21,8 V16 M5,14 L7,10 M17,14 L19,10"
                                      Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cotas de planta" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProjectSubtitle}" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="20,12,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Plantas -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,8,8,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PlanCountText}" FontSize="12" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="PLANTAS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,0,8,8">
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding OnlyChosen}" Content="Solo elegidas" FontSize="12"
                                  ToolTip="Muestra solo las plantas marcadas para planos."/>
                        <TextBlock Text="{Binding ChosenCountText}" FontSize="12" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#C3CAD2"/>
                        <TextBlock Text="Buscar planta…" Margin="11,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ListBox ItemsSource="{Binding PlansView}" SelectedItem="{Binding SelectedPlan}"
                             ItemContainerStyle="{StaticResource PlanItem}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:PlanItemViewModel}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChosen}" VerticalAlignment="Center" Margin="0,0,8,0"
                                              ToolTip="Esta planta va en planos"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource Muted}"
                                               VerticalAlignment="Top" Margin="6,2,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Level, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Meta, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Vista previa -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="14,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Border Style="{StaticResource Tag}"><TextBlock Text="{Binding ScaleText}" FontSize="12" Foreground="{StaticResource Muted}"/></Border>
                                <Border Style="{StaticResource Tag}"><TextBlock Text="{Binding ChainsText}" FontSize="12" Foreground="{StaticResource Muted}"/></Border>
                                <Border Style="{StaticResource Tag}"><TextBlock Text="{Binding SegmentsText}" FontSize="12" Foreground="{StaticResource Muted}"/></Border>
                            </StackPanel>
                            <TextBlock Text="{Binding PreviewTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="4" Padding="8" Background="White">
                            <Grid>
                                <ui:PlanPreview Scene="{Binding Scene}"/>
                                <TextBlock Text="Rueda: zoom · Arrastrar: mover · Doble clic: ajustar" FontSize="11"
                                           Foreground="{StaticResource Muted}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="LEYENDA" Style="{StaticResource Caps}"/>
                                <ItemsControl ItemsSource="{Binding Legend}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type domain:LegendEntry}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <ui:LegendSwatch Entry="{Binding}" Width="22" Height="16" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="180"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Visibility="{Binding HasBeamLegend, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                    <TextBlock Text="VIGAS" Style="{StaticResource Caps}"/>
                                    <ItemsControl ItemsSource="{Binding BeamLegend}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Configuración -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,0">
                        <Border Style="{StaticResource Section}">
                            <DockPanel>
                                <TextBlock Text="Escala 1:" VerticalAlignment="Center" Margin="0,0,8,0"
                                           ToolTip="El texto se queda en 2.5 mm en el papel: al cambiar la escala solo cambia el tamaño del dibujo."/>
                                <ComboBox ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScale}" MinHeight="30" VerticalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="COTAS POR LADO" Style="{StaticResource Caps}"
                                           ToolTip="De adentro hacia afuera: libres, eje a eje, voladizos y total. Los voladizos se miden desde el eje."/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Libres" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Ejes" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Voladizo" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Total" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Sides}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:SideRowViewModel}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="44"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding Libres}" HorizontalAlignment="Center"/>
                                                <CheckBox Grid.Column="2" IsChecked="{Binding EjeAEje}" HorizontalAlignment="Center"/>
                                                <CheckBox Grid.Column="3" IsChecked="{Binding Voladizo}" HorizontalAlignment="Center"/>
                                                <CheckBox Grid.Column="4" IsChecked="{Binding Total}" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="SEPARACIÓN (EN PAPEL)" Style="{StaticResource Caps}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Primera línea" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="6" Maximum="20" Value="{Binding FirstOffsetMm}" Margin="0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FirstOffsetText}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="Entre líneas" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="12" Value="{Binding SpacingMm}" Margin="0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SpacingText}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="NOMBRE DE VIGAS" Style="{StaticResource Caps}"
                                           ToolTip="“Corto” escribe V1, VI-1, VB en la planta y el nombre completo va en la leyenda."/>
                                <Border BorderBrush="#B8C0C9" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                    <UniformGrid Columns="2">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="BeamNaming" Content="Sección" IsChecked="{Binding UseSectionNames}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="BeamNaming" Content="Corto + leyenda" IsChecked="{Binding UseShortNames}"/>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="PRESENTACIÓN" Style="{StaticResource Caps}"/>
                                <CheckBox IsChecked="{Binding IncludeJoists}" Content="Viguetas en las cotas libres" Margin="0,2"/>
                                <CheckBox IsChecked="{Binding ShowReferenceLines}" Content="Líneas de referencia hasta lo medido" Margin="0,2"/>
                                <CheckBox IsChecked="{Binding MarkVoids}" Content="Marcar vacíos con X" Margin="0,2"/>
                                <CheckBox IsChecked="{Binding TintSlab}" Content="Losa en gris tenue" Margin="0,2"/>
                                <CheckBox IsChecked="{Binding LongTicks}" Content="Trazo diagonal largo en cotas" Margin="0,2"/>
                                <CheckBox IsChecked="{Binding ColoredChains}" Content="Cotas de colores (por tipo)" Margin="0,2"
                                          ToolTip="Apagado, todas las cotas y sus textos van en negro, como se entregan los planos."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}" BorderThickness="0">
                            <DockPanel>
                                <TextBlock Text="Tipo de cota" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox ItemsSource="{Binding DimensionTypes}" SelectedItem="{Binding SelectedDimensionType}" MinHeight="30" VerticalContentAlignment="Center"
                                          ToolTip="Se usa como base para crear un tipo de cota por color."/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
