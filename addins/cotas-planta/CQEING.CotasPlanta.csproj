<Project Sdk="Microsoft.NET.Sdk">

  <!-- Año de Revit, framework, API por NuGet y salida bin/<config>/<año>/: addins/Directory.Build.props. -->
  <PropertyGroup>
    <AssemblyName>CQEING.CotasPlanta</AssemblyName>
    <RootNamespace>CQEING.CotasPlanta</RootNamespace>
    <Company>CQEING</Company>
    <Product>CQEING - Cotas de planta</Product>
    <Copyright>© CQEING</Copyright>
  </PropertyGroup>

  <!-- Las pruebas son otro proyecto (net8.0 sin Revit): no se compilan dentro del add-in. -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="CQEING.CotasPlanta.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
